{
  "name": "moveinsync-playstore-ratings",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Rerunnable collector, classifier and weekly brief for MoveInSync Play Store ratings and reviews",
  "scripts": {
    "scrape": "node scripts/scrape.js",
    "scrape:full": "node scripts/scrape.js --full",
    "scrape:test": "node scripts/scrape.js --apps com.moveinsync.ets --max 300",
    "classify": "node scripts/classify.js",
    "classify:llm": "node scripts/classify.js --provider llm",
    "classify:rules": "node scripts/classify.js --provider rules",
    "classify:test": "node scripts/classify.js --days 30 --limit 10",
    "validate:sheet": "node scripts/make_handlabel_sheet.js --include ../reading/one_star_reading_set_A.csv --n 100",
    "validate:label": "node scripts/classify.js --ids validation/handlabels.xlsx && node scripts/classify.js --provider llm --ids validation/handlabels.xlsx && node scripts/classify.js --provider rules --ids validation/handlabels.xlsx",
    "validate": "node scripts/evaluate.js",
    "spotcheck:sheet": "node scripts/make_spotcheck_sheet.js --ids ../reading/one_star_reading_set_A.csv",
    "spotcheck": "node scripts/spotcheck_report.js",
    "spotcheck:round2": "node scripts/make_spotcheck_sheet.js --random 30 --seed round2 --exclude ../reading/one_star_reading_set_A.csv --tag round2",
    "spotcheck:round2:report": "node scripts/spotcheck_report.js --tag round2",
    "report": "node scripts/report.js",
    "replies": "node scripts/reply_drafts.js",
    "weekly": "npm run scrape && npm run classify && npm run replies && npm run report",
    "site:build": "cd site && npm install && npm run build",
    "setup:ci": "node -e \"const fs=require('fs');fs.mkdirSync('.github/workflows',{recursive:true});fs.copyFileSync('ci/weekly.yml','.github/workflows/weekly.yml');console.log('Copied ci/weekly.yml to .github/workflows/weekly.yml')\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "google-play-scraper": "10.1.3",
    "zod": "^3.25.76"
  }
}